#include <windows.h>

1 ICON "work/app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "WangNan"
            VALUE "FileDescription", "BUAA GPA Studio"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "BUAA GPA Studio"
            VALUE "OriginalFilename", "BUAA GPA Studio.exe"
            VALUE "ProductName", "BUAA GPA Studio"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 WangNan"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
